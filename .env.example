# Secure Login System V2 - environment variable template
# Copy to .env and replace every placeholder. Never commit .env.
# Generate independent secrets, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | testing | production
FLASK_ENV=development
FLASK_DEBUG=false

# At least 32 random characters. Independent from all other secrets.
FLASK_SECRET_KEY=replace-with-a-random-session-signing-secret

# Application-level password pepper. Versioning supports rotation.
# Set PASSWORD_PEPPER to the current pepper and keep old peppers as
# PASSWORD_PEPPER_V1, PASSWORD_PEPPER_V2, ... while hashes are migrated.
PASSWORD_PEPPER=replace-with-a-random-password-pepper
PASSWORD_PEPPER_VERSION=1
# PASSWORD_PEPPER_V1=replace-with-the-previous-pepper

# Key material used to derive the Fernet key that encrypts TOTP secrets.
# At least 32 random characters. Back this up securely.
TOTP_ENCRYPTION_KEY=replace-with-a-random-totp-encryption-key

# Independent key for HMAC-hashing recovery codes.
RECOVERY_CODE_PEPPER=replace-with-a-random-recovery-code-pepper

# Development uses SQLite by default when this is omitted.
# Production requires a PostgreSQL URL. postgres:// is normalised to
# postgresql+psycopg:// automatically; never use SQLite in production.
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_URL=sqlite:///instance/secure_login_v2.db

# Must be true in production.
SESSION_COOKIE_SECURE=false

# One-time bootstrap authorisation token for `flask create-admin`.
# Generate a random value and remove it after the first admin exists.
BOOTSTRAP_TOKEN=replace-with-a-random-one-time-bootstrap-token

# Operational settings
LOG_LEVEL=INFO
TRUSTED_PROXY_COUNT=1
PERMANENT_SESSION_LIFETIME_MINUTES=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TOTP_MAX_FAILED_ATTEMPTS=5
TOTP_LOCKOUT_MINUTES=15

# Use a shared Redis-compatible store in multi-instance deployments.
# memory:// is acceptable for a single Gunicorn worker.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true
